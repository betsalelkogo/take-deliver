rules_version = '2';

// The app now stores everything in Neon Postgres (see README.md); Firestore is
// only kept as a read-only backup of the data from before the move.
//
// Publish these rules (Firebase Console > Firestore Database > Rules) right
// after the Neon version is deployed, so phones still running the old version
// can't write to Firestore anymore. Reads stay open so
// `npm run migrate:firestore -- --only-new` can still copy late writes.
//
// Once nothing is left to copy, change `allow read` to `if false` as well.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
