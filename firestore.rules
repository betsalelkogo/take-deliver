rules_version = '2';

// Firestore Security Rules for the "packages" collection.
//
// This starter is an OPEN board (no login): anyone can read and write packages.
// That is convenient for a small, trusted group sharing one link, but it means
// anyone with the URL can add/edit/delete entries.
//
// The rules below at least:
//   - validate the shape of incoming documents,
//   - cap string lengths to limit abuse,
//   - restrict status to known values.
//
// For anything beyond a trusted group, add Firebase Authentication and gate
// writes on `request.auth != null` (see commented example at the bottom).

service cloud.firestore {
  match /databases/{database}/documents {

    match /packages/{packageId} {

      function validPackage(data) {
        // A package must have a location: either the new area/store fields
        // or the legacy pickupLocation field.
        return (
            (data.area is string && data.area.size() > 0 && data.area.size() <= 100)
            || (data.pickupLocation is string && data.pickupLocation.size() > 0)
          )
          && data.ownerName is string
          && data.ownerName.size() > 0
          && data.ownerName.size() <= 100
          && data.ownerPhone is string
          && data.ownerPhone.size() > 0
          && data.status in ['available', 'claimed', 'delivered']
          // A collected package must record who took it (name + phone).
          && (
            data.status != 'claimed'
            || (
              data.courierPhone is string && data.courierPhone.size() > 0
              && data.courierName is string && data.courierName.size() > 0
            )
          );
      }

      allow read: if true;
      allow create: if validPackage(request.resource.data);
      allow update: if validPackage(request.resource.data);
      allow delete: if true;

      // --- Recommended hardening with Firebase Auth ---
      // allow read: if request.auth != null;
      // allow create, update, delete: if request.auth != null
      //   && validPackage(request.resource.data);
    }

    match /stats/{docId} {
      // A simple public counter of packages collected all-time.
      allow read: if true;
      allow write: if request.resource.data.collected is number;
    }

    match /stores/{storeId} {

      function validStore(data) {
        return data.area is string
          && data.area.size() > 0
          && data.area.size() <= 100
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 100;
      }

      allow read: if true;
      allow create: if validStore(request.resource.data);
      allow update: if validStore(request.resource.data);
      allow delete: if true;

      // --- Recommended hardening with Firebase Auth ---
      // allow read: if request.auth != null;
      // allow create, update, delete: if request.auth != null
      //   && validStore(request.resource.data);
    }
  }
}
