# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Neon Postgres connection string (server-only secret — do NOT prefix with NEXT_PUBLIC_).
# Neon Console > your project > Dashboard > "Connect" (use the pooled connection string).
NEON_DB_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Only needed by `npm run migrate:firestore` (one-off copy from the old Firebase project).
# Firebase Console > Project settings > General > "Your apps" > Web app config.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<firebase-project-id>
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
